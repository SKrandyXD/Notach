# Emulator-only defaults. Replace all Firebase values for a cloud project.
VITE_FIREBASE_API_KEY=local-development
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-notach
VITE_FIREBASE_APP_ID=local-development
VITE_FIREBASE_MESSAGING_SENDER_ID=local-development
# Empty API URL uses packages/shared/src/local-services.json.
# Production requires the absolute HTTPS URL of the deployed API.
VITE_API_BASE_URL=
# Empty emulator hosts use packages/shared/src/local-services.json.
VITE_FIREBASE_AUTH_EMULATOR_HOST=
VITE_FIRESTORE_EMULATOR_HOST=
VITE_USE_FIREBASE_EMULATORS=true
