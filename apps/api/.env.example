# Local ports/hosts default to packages/shared/src/local-services.json.
# Optional app-specific overrides: PORT, FIRESTORE_EMULATOR_HOST,
# FIREBASE_AUTH_EMULATOR_HOST and CORS_ORIGIN. Omit them to follow the shared config.
NODE_ENV=development
FIREBASE_PROJECT_ID=demo-notach
USE_FIREBASE_EMULATORS=true
GOOGLE_APPLICATION_CREDENTIALS=../../backend/secrets/service-account.json
AI_PROVIDER=mock
GEMINI_API_KEY=
# Default for generation; selectable IDs are in src/config/models.ts.
GEMINI_MODEL=gemini-3.5-flash-lite
AI_PROMPT_VERSION=notach-summary-v1
MAX_NOTE_CHARS=50000
# Per-user calculated Standard token cost budget, reset each UTC hour.
AI_HOURLY_BUDGET_USD=0.10
AI_TIMEOUT_MS=120000
